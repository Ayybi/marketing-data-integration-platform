# --- Storage (your change: MongoDB replaces Supabase/Postgres) ---
# Local: mongodb://127.0.0.1:27017 — Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=marketing_data_hub

# --- Credential vault (doc Part A §5) ---
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_VAULT_KEY=

# --- Cron guard (doc §8) ---
CRON_SECRET=

# --- LLM (your change: provider-agnostic; used by the CallRail classifier) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Connector credentials (doc §10). Optional per source; each degrades cleanly when unset. ---
# Call-tracking provider (pluggable). Default: callrail. Add adapters + cases in src/lib/calltracking/index.ts.
CALL_TRACKING_PROVIDER=callrail
CALLRAIL_API_KEY=
GA4_SERVICE_ACCOUNT_JSON=
GA4_SERVICE_ACCOUNT_PATH=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
META_ACCESS_TOKEN=
# SEO data provider (pluggable). Default: semrush. Add adapters + cases in src/lib/seo/index.ts.
SEO_PROVIDER=semrush
SEMRUSH_API_KEY=
STRIPE_SECRET_KEY=
